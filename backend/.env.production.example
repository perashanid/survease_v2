# Production Environment Variables Template
# Copy this file and set actual values for your production deployment

# ============================================
# CRITICAL: EMAIL CONFIGURATION
# ============================================
# These MUST be set for email to work in production!

# Brevo (Sendinblue) SMTP Configuration
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false

# Get these from: https://app.brevo.com/settings/keys/smtp
SMTP_USER=your-brevo-smtp-login@smtp-brevo.com
SMTP_PASSWORD=your-brevo-smtp-password

# Must be a verified sender in Brevo
EMAIL_FROM=SurvEase <your-verified-email@yourdomain.com>

# ============================================
# APPLICATION URLS (CRITICAL!)
# ============================================
# Set these to your actual production URLs
FRONTEND_URL=https://your-frontend-domain.com
BACKEND_URL=https://your-backend-domain.com
API_BASE_URL=https://your-backend-domain.com/api

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=8000
NODE_ENV=production

# ============================================
# DATABASE
# ============================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
DB_NAME=survey_platform

# ============================================
# SECURITY (Generate strong random strings!)
# ============================================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_RANDOM_STRING_64_CHARS_MIN
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=CHANGE_THIS_TO_DIFFERENT_RANDOM_STRING
JWT_REFRESH_EXPIRES_IN=30d
SESSION_SECRET=CHANGE_THIS_TO_RANDOM_STRING
COOKIE_SECRET=CHANGE_THIS_TO_RANDOM_STRING

# ============================================
# CORS (Add your frontend domain)
# ============================================
CORS_ORIGIN=https://your-frontend-domain.com

# ============================================
# RATE LIMITING (Production settings)
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# SECURITY SETTINGS
# ============================================
BCRYPT_ROUNDS=12
ENABLE_HELMET=true
ENABLE_RATE_LIMIT=true
TRUST_PROXY=true

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
ENABLE_LOGGING=true

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_REGISTRATION=true
ENABLE_PUBLIC_SURVEYS=true
ENABLE_SURVEY_IMPORT=true
ENABLE_EMAIL_VERIFICATION=false
ENABLE_ANALYTICS=true
ENABLE_AI_FEATURES=true

# ============================================
# AI CONFIGURATION (Optional)
# ============================================
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash-exp
AI_INSIGHTS_CACHE_TTL=3600
AI_GENERATION_TIMEOUT=30000

# ============================================
# FILE UPLOAD
# ============================================
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# ============================================
# PAGINATION
# ============================================
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# ============================================
# SURVEY LIMITS
# ============================================
MAX_QUESTIONS_PER_SURVEY=100
MAX_OPTIONS_PER_QUESTION=50
MAX_SURVEY_TITLE_LENGTH=200
MAX_SURVEY_DESCRIPTION_LENGTH=1000
MAX_TEXT_RESPONSE_LENGTH=5000
ENABLE_ANONYMOUS_RESPONSES=true

# ============================================
# CACHE (Optional)
# ============================================
CACHE_TTL=3600
ENABLE_CACHE=false

# ============================================
# API CONFIGURATION
# ============================================
API_VERSION=v1
API_TIMEOUT=30000
MAX_EXPORT_SIZE_MB=50

# ============================================
# DEPLOYMENT PLATFORM SPECIFIC
# ============================================

# For Render.com:
# - Set these in Dashboard → Environment
# - Service auto-restarts on changes

# For Vercel:
# - Set in Project Settings → Environment Variables
# - Select "Production" environment
# - Redeploy after adding variables

# For Railway:
# - Set in Service → Variables
# - Service auto-restarts on changes

# For Heroku:
# heroku config:set VARIABLE_NAME=value

# For AWS/DigitalOcean:
# - Set in your deployment configuration
# - Or use .env file with proper permissions
